{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "scripts/**/*",
    "tests/**/*.ts"
  ],
  // Milestone 24: tests/unit/server/** exercises server/src (the standalone
  // Postgres/Express server, type-checked separately by tsconfig.server.json
  // via `npm run server:build`) against the real Neon TEST branch through
  // Vitest, which transpiles per-file via esbuild rather than doing a project
  // -wide `tsc` check — so, unlike every other tests/**/*.ts file, it was
  // never meant to be resolvable from THIS project. Excluded here so
  // `npm run build`'s `tsc --noEmit -p tsconfig.node.json` doesn't fail
  // trying to resolve server/src imports that tsconfig.node.json's own
  // `include` list intentionally never lists (they belong to
  // tsconfig.server.json's rootDir instead).
  //
  // Same reasoning for the two dues-tracker backup/restore scripts — they
  // import server/src/db/schema.ts directly (no repo/service layer sits
  // between a raw table backup and the database), run via `tsx` (which
  // transpiles per-file, no project-wide resolution needed), and were
  // never meant to be resolvable from this project either.
  "exclude": [
    "tests/unit/server/**",
    "scripts/backup-dues-tracker.ts",
    "scripts/restore-dues-tracker.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "outDir": "out-tsc/node"
  }
}

# Native modules (better-sqlite3) must be compiled/fetched for Electron's Node
# ABI, not the system Node used to run npm — see README note in package.json
# scripts. These target the Electron version pinned in devDependencies.
runtime=electron
target=32.3.3
disturl=https://electronjs.org/headers
target_arch=x64
build_from_source=false
